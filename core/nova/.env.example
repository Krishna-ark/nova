# NOVA configuration template.
#
# Copy this file to .env and fill in the required values:
#   Copy-Item .env.example .env
#
# .env is git-ignored and must never be committed.
# Every variable below is optional EXCEPT NOVA_SECURITY__AUTH_TOKEN.

# --- Environment -----------------------------------------------------
# development | production
NOVA_ENVIRONMENT=development

# --- Security (REQUIRED) ---------------------------------------------
# No default exists in any environment. NOVA will refuse to start
# without this. Minimum 32 characters.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Left deliberately empty: copying this file unchanged must fail
# rather than produce a working install with a publicly known token.
NOVA_SECURITY__AUTH_TOKEN=

# --- Server ----------------------------------------------------------
# Phase 1 is localhost-only.
NOVA_SERVER__HOST=127.0.0.1
NOVA_SERVER__PORT=8765
NOVA_SERVER__ALLOW_NON_LOCAL=false

# --- Database --------------------------------------------------------
# Defaults to %LOCALAPPDATA%\NOVA\nova.db when unset.
# NOVA_DATABASE__PATH=
NOVA_DATABASE__ENABLE_WAL=true
NOVA_DATABASE__BUSY_TIMEOUT_SECONDS=5.0

# --- Logging ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NOVA_LOGGING__LEVEL=INFO
# Defaults to %LOCALAPPDATA%\NOVA\logs when unset.
# NOVA_LOGGING__DIRECTORY=
NOVA_LOGGING__FILENAME=nova.log
NOVA_LOGGING__CONSOLE_PRETTY=true
NOVA_LOGGING__MAX_BYTES=10485760
NOVA_LOGGING__BACKUP_COUNT=5