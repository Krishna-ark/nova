# NOVA configuration template.

NOVA_ENVIRONMENT=development

# REQUIRED. Generate a real token for your local .env.
NOVA_SECURITY__AUTH_TOKEN=

NOVA_SERVER__HOST=127.0.0.1
NOVA_SERVER__PORT=8765
NOVA_SERVER__ALLOW_NON_LOCAL=false

NOVA_DATABASE__ENABLE_WAL=true
NOVA_DATABASE__BUSY_TIMEOUT_SECONDS=5.0

NOVA_LOGGING__LEVEL=INFO
NOVA_LOGGING__FILENAME=nova.log
NOVA_LOGGING__CONSOLE_PRETTY=true
NOVA_LOGGING__MAX_BYTES=10485760
NOVA_LOGGING__BACKUP_COUNT=5
